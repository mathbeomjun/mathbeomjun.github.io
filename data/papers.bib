% ═════════════════════════════════════════════════════════════════════
%  data/papers.bib — 모든 논문의 원본 (홈페이지·공개 CV·전체 기록이 모두 여기서 만들어짐)
% ═════════════════════════════════════════════════════════════════════
%
%  ▶ 분류: status 필드로 정합니다.
%      status = {preprint}  → "Preprints"     홈페이지에는 arXiv 링크만 표시
%      status = {accepted}  → "Publications"  "Journal, accepted"로 표시 (권·쪽 없이)
%      status 줄 없음       → "Publications"  게재 완료. journal, year, doi 필수
%      status = {other}     → "Other publications"  심사 논문이 아닌 출판물 (Oberwolfach Reports 등).
%                             논문 통계(published/accepted/preprints)에는 세지 않음
%
%  ▶ 정렬: 연도(year) 내림차순. 같은 연도 안에서는 이 파일에 적힌 순서(위가 먼저).
%    새 논문은 해당 구역의 맨 위에 추가하세요.
%
%  ▶ 저자: "성, 이름" 형식으로 and 로 연결. 본인은 반드시 정확히 "Choi, Beomjun".
%    본인은 자동으로 빠지고 나머지가 "with A, B and C"로 표시됩니다.
%    공저자는 "Kim, A." 처럼 이니셜로 적으면 화면에도 "A. Kim"으로 나옵니다.
%    (성이 Choi 인 공저자라도 이름이 Beomjun 이 아니면 공저자로 처리됩니다.)
%
%  ▶ 필드 정리
%      author, title, year                     필수
%      eprint = {2701.01234}                   arXiv 번호만 (링크는 abs 페이지로 자동 생성)
%      archiveprefix = {arXiv}                 eprint 가 있으면 함께
%      journal = {Adv. Math.}                  약어 표기 (MathSciNet 약어 권장)
%      volume, number, pages = {931--1016}     CV에만 표시. 쪽 범위는 하이픈 두 개(--)
%      doi = {10.xxxx/...}                     "https://doi.org/" 없이 번호만. 제목 링크가 됨
%      url = {...}                             DOI가 없을 때만 저널 페이지 주소
%      note = {...}                            홈페이지에 작은 기울임으로 표시되는 부연
%      hide = {cv} 또는 {web} 또는 {cv, web}    해당 출력에서만 숨김 (record에는 항상 표시)
%      status = {preprint|accepted|other}      위 분류 참조
%
%  ▶ 제목 표기: 수식은 $...$ (예: $\mathbb{R}^4$), 대시는 --(en dash), 특수문자는 그대로 유니코드(Ł, é).
%    홈페이지에서는 간단한 수식(ℝ, 위첨자, 그리스 문자)만 변환됩니다.
%
%  ▶ 상태가 바뀔 때 (예: 프리프린트가 게재 승인 → 출판)
%      1) 승인: 항목을 "Accepted" 구역으로 옮기고 status = {accepted}, journal 추가, year 갱신
%      2) 출판: status 줄 삭제, doi·volume·pages 추가, "Published" 구역 맨 위로 이동
%      인용 키(@article{여기}) 는 바꾸지 마세요. private.yml 의 paper_notes 가 이 키로 연결됩니다.
%
%  ▶ 새 프리프린트 템플릿
%      @article{ChoiKim2027Example,
%        author        = {Choi, Beomjun and Kim, A.},
%        title         = {Title of the new preprint},
%        year          = {2027},
%        eprint        = {2701.01234},
%        archiveprefix = {arXiv},
%        status        = {preprint}
%      }
% ─────────────────────────────────────────────────────────────────────

