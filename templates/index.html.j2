{# Web design only. Content comes from data/cv.yml and data/papers.bib.
   outputs.web controls sections and their order. Keep the inline build supported. #}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ profile.name }} ({{ profile.name_ko }})</title>
<meta name="description" content="{{ profile.name }}, {{ profile.position }}, {{ profile.department }}, {{ profile.institution }}. {{ profile.interests_web | e }}.">
{# 검색엔진·링크 미리보기용 정보. 내용은 cv.yml 의 profile 에서 자동으로 채워집니다. #}
{% set site = (profile.site_url or profile.url or '').rstrip('/') %}
{% set desc = profile.name ~ ' (' ~ profile.name_ko ~ '), ' ~ profile.position ~ ', ' ~ profile.department ~ ', ' ~ profile.institution ~ '. ' ~ profile.interests_web ~ '.' %}
{% if site %}
<link rel="canonical" href="{{ site }}/">
<meta property="og:url" content="{{ site }}/">
{% endif %}
{% if profile.google_site_verification %}
<meta name="google-site-verification" content="{{ profile.google_site_verification }}">
{% endif %}
<meta property="og:type" content="profile">
<meta property="og:site_name" content="{{ profile.name }}">
<meta property="og:title" content="{{ profile.name }} ({{ profile.name_ko }})">
<meta property="og:description" content="{{ desc | e }}">
<meta property="og:locale" content="en_US">
<meta property="og:locale:alternate" content="ko_KR">
<meta property="profile:first_name" content="{{ profile.name.split(' ')[0] }}">
<meta property="profile:last_name" content="{{ profile.name.split(' ')[-1] }}">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{{ profile.name }} ({{ profile.name_ko }})">
<meta name="twitter:description" content="{{ desc | e }}">
<script type="application/ld+json">
{{ jsonld }}
</script>
<style>
@font-face { font-family: "Source Serif 4"; src: url("assets/type/SourceSerif4-Regular.woff2") format("woff2"); font-weight: 400; font-style: normal; font-display: swap; }
@font-face { font-family: "Source Serif 4"; src: url("assets/type/SourceSerif4-It.woff2") format("woff2"); font-weight: 400; font-style: italic; font-display: swap; }
</style>
{% if inline %}
<style>
{{ inline_css }}
</style>
{% else %}
<link rel="stylesheet" href="assets/style.css?v={{ style_version }}">
{% endif %}
</head>
{# Long lists use the same filtered data and ordering as their short previews. #}
{% macro entries(items, limit, noun, render_item) %}
  <ul class="entries">
  {% for item in items[:limit] %}<li>{{ render_item(item) }}</li>{% endfor %}
  </ul>
  {% if items|length > limit %}
  <details class="more">
    <summary><span class="when-closed">Show all {{ items|length }} {{ noun }}</span><span class="when-open">Show fewer {{ noun }}</span></summary>
    <ul class="entries">
    {% for item in items[limit:] %}<li>{{ render_item(item) }}</li>{% endfor %}
    </ul>
  </details>
  {% endif %}
{% endmacro %}

{% macro title_link(title, url) -%}
  {% if url %}<a class="entry-title" href="{{ url|e }}">{{ title|t }}</a>{% else %}<span class="entry-title">{{ title|t }}</span>{% endif %}
{%- endmacro %}

{% macro paper(p) %}
  {{ title_link(p.title, p.journal_url or p.arxiv_url) }}
  <div class="citation">
    <p class="meta">{% if p.with %}<span>with {{ p.with|e }}</span>{% endif %}{% if p.journal %}<span><i>{{ p.journal|e }}</i>{% if p.status == 'accepted' %}, accepted{% endif %}</span>{% endif %}<span>{{ p.year }}</span></p>
    {% if p.arxiv_url or p.journal_url %}<p class="sources">{% if p.arxiv_url %}<a href="{{ p.arxiv_url|e }}">arXiv</a>{% endif %}{% if p.journal_url %}<a href="{{ p.journal_url|e }}">Journal</a>{% endif %}</p>{% endif %}
  </div>
  {% if p.note %}<p class="annotation">{{ p.note|t }}</p>{% endif %}
{% endmacro %}

{% macro position(e) %}
  <span class="entry-title">{{ (e.web or (e.role ~ ', ' ~ e.org))|e }}</span><p class="meta">{{ e.period|e }}</p>
{% endmacro %}
{% macro degree(e) %}
  <span class="entry-title">{{ e.degree|e }}</span>
  <p class="meta"><span>{{ e.place|e }}</span><span>{{ e.period|e }}</span></p>
  {% for line in e.notes %}<p class="annotation">{{ line|e }}</p>{% endfor %}
{% endmacro %}
{% macro conference(o) %}
  {{ title_link(o.title, link(o)) }}
  <p class="meta">{% if o.date %}<span>{{ o.date|e }}</span>{% endif %}{% if o.place %}<span>{{ o.place|e }}</span>{% endif %}{% if o.status == 'upcoming' %}<span>Upcoming</span>{% endif %}</p>
  {% if o.with_str %}<p class="annotation">Co-organized with {{ o.with_str|e }}</p>{% endif %}
  {% if o.links %}<p class="sources">{% for item in o.links %}{% if link(item) %}<a href="{{ link(item)|e }}">{{ item.label|e }}</a>{% endif %}{% endfor %}</p>{% endif %}
{% endmacro %}
{% macro appointment(e) %}
  {{ title_link(e.title, link(e)) }}<p class="meta">{{ e.period|e }}</p>
{% endmacro %}
{% macro course(c) %}
  {# Move a leading alphanumeric course code into the term line, if present. #}
  {% set parts = c.course.split(' ', 1) %}
  {% set code = parts[0] if parts|length == 2 and parts[0].isalnum() and parts[0][0].isalpha() and parts[0][-1].isdigit() else '' %}
  {{ title_link(parts[1] if code else c.course, link(c)) }}
  <p class="meta">{% if code %}<span>{{ code|e }}</span>{% endif %}<span>{{ c.term|e }}</span>{% if c.place %}<span>{{ c.place|e }}</span>{% endif %}</p>
{% endmacro %}
{% macro note(n) %}
  {{ title_link(n.title, link(n)) }}{% if n.description %}<p class="annotation">{{ n.description|e }}</p>{% endif %}
{% endmacro %}

<body id="top">
<a class="skip" href="#main">Skip to content</a>
<div class="sheet">
  <header class="masthead">
    <a class="wordmark" href="#top">{{ profile.name|e }} <span>/ {{ profile.institution|e }}</span></a>
    <nav aria-label="Sections">
      {% if on('publications') or on('preprints') %}<a href="#{{ 'papers' if on('publications') else 'preprints' }}">Papers</a>{% endif %}
      {% if on('organized') %}<a href="#organized">Conferences</a>{% endif %}
      {% if on('teaching') %}<a href="#teaching">Teaching</a>{% endif %}
      <a href="cv.pdf" aria-label="Curriculum vitae (PDF)">CV</a>
    </nav>
  </header>

  <main id="main">
    <header class="hero">
      <div class="identity">
        <h1>{{ profile.name|e }}</h1>
        {% if profile.name_ko %}<p class="korean" lang="ko">{{ profile.name_ko|e }}</p>{% endif %}
        {% if profile.interests_web %}<p class="interests">{{ profile.interests_web|e }}</p>{% endif %}
        <div class="affiliation">
          <p>{{ profile.position|e }}<br>{{ profile.department|e }}, {{ profile.institution|e }}</p>
          {% if profile.emails %}<p class="emails">{% for m in profile.emails %}<a href="mailto:{{ m|e }}">{{ m|e }}</a>{% endfor %}</p>{% endif %}
        </div>
      </div>
      <figure class="flow">
        <canvas id="flow" width="340" height="340" role="button" aria-label="Draw a new curve shortening flow" aria-describedby="flow-caption"></canvas>
        <figcaption id="flow-caption"><i>Curve shortening flow</i><span>Click the curve to redraw</span></figcaption>
      </figure>
    </header>

    {% set sections = {
      'publications': ('papers', 'Publications', publications, 6, 'publications', paper),
      'preprints': ('preprints', 'Preprints', preprints, 6, 'preprints', paper),
      'others': ('other-publications', 'Other publications', others, 6, 'publications', paper),
      'positions': ('positions', 'Positions', vis(positions), 5, 'positions', position),
      'education': ('education', 'Education', vis(education), 3, 'degrees', degree),
      'organized': ('organized', 'Conferences organized', vis(organized), 3, 'conferences', conference),
      'grants': ('grants', 'Grants and honors', vis(grants), 4, 'grants and honors', appointment),
      'service': ('service', 'Service', vis(service), 4, 'entries', appointment),
      'teaching': ('teaching', 'Teaching', vis(teaching.instructor), 3, 'courses', course),
      'notes': ('notes', 'Notes', vis(notes), 4, 'notes', note)
    } %}
    {% for key in outputs.web if key in sections %}
      {% set id, heading, items, limit, noun, render_item = sections[key] %}
      <section class="section" id="{{ id }}" aria-labelledby="{{ id }}-title">
        <h2 id="{{ id }}-title">{{ heading }}</h2>
        <div class="section-content">
          {{ entries(items, limit, noun, render_item) }}
          {% if key == 'teaching' and vis(teaching.assistant) %}
          <details class="more assistant">
            <summary>Teaching assistant at Columbia University, 2012–2018</summary>
            <ul class="entries">{% for c in vis(teaching.assistant) %}<li>{{ course(c) }}</li>{% endfor %}</ul>
          </details>
          {% endif %}
        </div>
      </section>
    {% endfor %}
  </main>
  <footer class="foot">
    <a class="wordmark" href="#top">{{ profile.name|e }}</a>
    <div>{% if profile.address %}<p>{{ profile.address|e }}</p>{% endif %}<p>Updated <time datetime="{{ updated_iso }}">{{ updated }}</time></p></div>
    <a class="foot-cv" href="cv.pdf">Curriculum vitae (PDF)</a>
  </footer>
</div>

{% if inline %}
<script>
{{ inline_js }}
</script>
{% else %}
<script src="assets/flow.js?v={{ script_version }}" defer></script>
{% endif %}
</body>
</html>
